<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Wake-ups from a UnifiedPush distributor. Not exported: only the connector,
         inside this app, binds it. -->
    <application>
        <service
            android:name="dev.meshm.mem_push.PushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT"/>
            </intent-filter>
        </service>
    </application>
</manifest>
